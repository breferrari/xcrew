{
  "name": "xcrew",
  "displayName": "Xcrew",
  "version": "0.8.5",
  "description": "Your Xcode crew inside Claude Code: three MCP servers working as one, with live build progress and test reports Claude can act on.",
  "author": {
    "name": "Brenno Ferrari",
    "url": "https://github.com/breferrari"
  },
  "homepage": "https://github.com/breferrari/xcrew",
  "repository": "https://github.com/breferrari/xcrew",
  "license": "MIT",
  "privacyPolicyUrl": "https://github.com/breferrari/xcrew#privacy",
  "documentationUrl": "https://github.com/breferrari/xcrew#readme",
  "supportUrl": "https://github.com/breferrari/xcrew/issues",
  "keywords": [
    "ios",
    "xcode",
    "swift",
    "mcp",
    "simulator",
    "xcodebuild"
  ],
  "types": "./types/index.d.ts",
  "mcpServers": {
    "MobileBuildMCP": {
      "command": "${CLAUDE_PLUGIN_ROOT}/libexec/mobilebuildmcp-server",
      "args": [
        "${CLAUDE_PROJECT_DIR}"
      ],
      "env": {
        "MOBILEBUILDMCP_SENTRY_DISABLED": "true"
      }
    },
    "xcode": {
      "command": "${CLAUDE_PLUGIN_ROOT}/libexec/xcode-mcp-server"
    },
    "sosumi": {
      "type": "http",
      "url": "https://sosumi.ai/mcp"
    }
  }
}
