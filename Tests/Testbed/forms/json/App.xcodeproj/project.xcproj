{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/App.app", "id": "791B66FA3093F3AD000CEF21", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/AppTests.xctest", "id": "791C36FF3093F3AD004E4D73", "type": "wrapper.cfbundle", "index": false },
      ],
    },
    { "kind": "folder", "path": "App", "target-membership": [ "App" ] },
    { "kind": "folder", "path": "AppTests", "target-membership": [ "AppTests" ] },
  ],
  "targets": [
    {
      "name": "App",
      "id": "791B66F93093F3AD000CEF21",
      "product": "Products/App.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.xcrew.testbed.App",
        "PRODUCT_NAME": "$(TARGET_NAME)",
      },
    }, {
      "name": "AppTests",
      "id": "791C36FE3093F3AD004E4D73",
      "product": "Products/AppTests.xctest",
      "product-type": "bundle.unit-test",
      "dependencies": [
        "App",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.xcrew.testbed.AppTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/App.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/App",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ENABLE_TESTABILITY": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
    "SDKROOT": "iphoneos",
    "SWIFT_VERSION": "5.0",
    "TARGETED_DEVICE_FAMILY": "1,2",
  },
}
