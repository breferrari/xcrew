#!/bin/sh
# Runs the xcrew Swift CLI, building it first when no build matches the current sources.
# Builds are cached by a hash of the sources, so updating the plugin rebuilds once and Swift's
# ABI stability keeps a build working across Xcode updates. Build output goes to stderr only:
# hooks reply on stdout.
set -eu

# The plugin folder, found without a subshell; the working directory is put back, since the CLI
# reads it to find the project.
here=$PWD
case $0 in */*) cd -P "${0%/*}/.." ;; *) cd -P "$(dirname "$(command -v "$0")")/.." ;; esac
root=$PWD
cd "$here"
cache=${XCREW_CACHE:-"$HOME/Library/Caches/xcrew"}

# The session id in a hook's JSON on standard input, kept to the characters a stamp's file name takes, `_` for none,
# as SessionStamp.fileName names it (ManifestTests pairs them).
hook_session() {
    named=$(printf '%s' "$1" | tr -d '\n' | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | tr -cd 'A-Za-z0-9_-')
    printf '%s' "${named:-_}"
}

# Takes a briefing left due, by a rename only one taker can make: true for the one that took it.
take_due() {
    mv "$1" "$1.taken-$$" 2>/dev/null || return 1
    rm -f "$1.taken-$$"
}

# The Claude Code this hook runs under, by its process id and when it started, as `ps` prints it in the C locale; `none`
# outside one. A briefing left due names it, so a late start takes only the briefings its own Claude Code's starts left,
# not one a Claude Code that's gone left.
claude_code() {
    p=$$
    while [ "${p:-0}" -gt 1 ]; do
        command=$(ps -o comm= -p "$p" 2>/dev/null) || break
        if [ "${command##*/}" = claude ]; then
            printf '%s %s\n' "$p" "$(LC_ALL=C ps -o lstart= -p "$p" | tr -s ' ')"
            return
        fi
        p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
    done
    echo none
}

# Takes one briefing a start of this Claude Code left due for the session `$1`: true for the start that took one.
take_own_due() {
    owner=$(claude_code)
    for left in "$cache/briefings/$1".due.*; do
        [ -f "$left" ] && [ "$(cat "$left" 2>/dev/null)" = "$owner" ] && take_due "$left" && return 0
    done
    return 1
}

# A session's end only moves its stamp aside and removes it: Claude Code gives SessionEnd hooks 1.5 s in all, which
# a plugin's own timeout doesn't raise (docs/findings.md, *The session hooks*). So it hashes nothing, starts no CLI
# and never builds. One rename takes the whole stamp at once: a cancel leaves it there or gone, never half of it, and
# one left aside is pruned with the other stamps.
if [ "${1:-}" = hook ] && [ "${2:-}" = session-end ]; then
    session=$(hook_session "$(cat)")
    aside="$cache/sessions/.ended-$session-$$"
    mv "$cache/sessions/$session" "$aside" 2>/dev/null && rm -rf "$aside"
    rm -f "$cache/sessions/$session.json" "$cache/briefings/$session.due" "$cache/briefings/$session".due.*
    exit 0
fi
# Hashing every source takes most of this script's time. The key is kept in the cache, under this
# checkout's path, and worked out again only when something under the sources changed after it: an
# edit or a deletion (which changes its folder) by modification time, and a copy or unpacking, which
# can set that back, by change time.
stamp="$cache/roots$root.key"
key=
if [ -f "$stamp" ] && [ -z "$(find "$root/Package.swift" "$root/Sources" \( -newer "$stamp" -o -cnewer "$stamp" \) -print -quit 2>/dev/null)" ]; then
    read -r key < "$stamp" || key=
fi
if [ -z "$key" ]; then
    mkdir -p "${stamp%/*}"
    # The stamp takes the time hashing began, so an edit saved while it runs is newer and seen next time.
    began="$stamp.$$"
    : > "$began"
    key=$(cd "$root" && find Package.swift Sources -type f -name '*.swift' | LC_ALL=C sort | xargs cat | shasum | cut -c1-16)
    { printf '%s\n' "$key" > "$began.key" && touch -r "$began" "$began.key" && mv "$began.key" "$stamp"; } 2>/dev/null || true
    rm -f "$began" "$began.key"
fi
binary="$cache/$key/xcrew"

# A session's start never waits on a build, as Claude's first answer waits on it. With a build there, it briefs at
# once and clears what's due. With none, it leaves a briefing due, named for this start and its Claude Code, and says
# the CLI is being built; the late start, an async hook, builds or waits for the build, takes one briefing its Claude
# Code's starts left due and gives it with the next turn. A briefing is taken by a rename only one start can make, so a
# start is briefed once, and one left by a Claude Code that's gone is no start's (docs/findings.md, *The session hooks*).
if [ "${1:-}" = hook ] && [ "${2:-}" = session-start ]; then
    input=$(cat)
    session=$(hook_session "$input")
    if [ "${3:-}" = --late ]; then
        # Built in a shim of its own, so a failed build is said rather than ending this one.
        # A failed build is said whether or not the start has left its briefing due yet: no start briefed without a build.
        # An async hook's words reach Claude as its JSON's additionalContext.
        if ! binary=$("$root/bin/xcrew" --binary-path); then
            take_own_due "$session" || true
            printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"xcrew: its CLI couldn'"'"'t be built for this version, so the briefing on this project and its tools isn'"'"'t given; /xcrew doctor says why."}}'
            exit 0
        fi
        take_own_due "$session" || exit 0
    elif [ -x "$binary" ]; then
        # This start briefs now: a briefing an earlier start left due is covered by this one, and one a Claude Code that's
        # gone left is no one's.
        rm -f "$cache/briefings/$session.due" "$cache/briefings/$session".due.*
    else
        due="$cache/briefings/$session.due.$$"
        mkdir -p "${due%/*}"
        claude_code > "$due"
        # A build that landed meanwhile is the start's to brief from, if the late start hasn't taken it.
        if [ ! -x "$binary" ]; then
            echo "xcrew: its CLI is being built for this version; the briefing on this project and its tools follows with the next turn, once it's built."
            exit 0
        fi
        take_due "$due" || exit 0
    fi
    set -- hook session-start
    starting=1
fi

# The MobileBuildMCP launcher asks only of a build that's there: a first build would hold up the server's start.
# 75 is sysexits' EX_TEMPFAIL: try again later.
if [ "${1:-}" = --if-built ]; then
    shift
    [ -x "$binary" ] || exit 75
fi

if [ ! -x "$binary" ]; then
    # One build at a time: at session start the hook and the mod both start this. The second waits,
    # then finds the first one's build. The holder writes its process id, so a lock left by a build
    # that was killed outright (no trap runs on SIGKILL) is cleared at once; ten minutes is the backstop.
    lock="$cache/.lock"
    mkdir -p "$cache"
    until mkdir "$lock" 2>/dev/null; do
        holder=$(cat "$lock/pid" 2>/dev/null || true)
        if { [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; } || [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
            rm -rf "$lock"
            continue
        fi
        sleep 1
    done
    echo $$ > "$lock/pid"
    trap 'rm -rf "$lock"' EXIT
fi
if [ ! -x "$binary" ]; then
    echo "xcrew: building the CLI for this version (once, 10 to 20 s)…" >&2
    swift build -c release --product xcrew --package-path "$root" --scratch-path "$cache/build" >&2
    mkdir -p "$cache/$key"
    cp "$cache/build/release/xcrew" "$binary.partial"
    mv "$binary.partial" "$binary"
    # An installed plugin builds once a version, so its scratch folder speeds no later build; a git
    # checkout keeps it for the next edit's.
    [ -e "$root/.git" ] || rm -rf "$cache/build"
    # Builds no checkout has run for two weeks go. Another checkout's current build stays: the
    # installed plugin and a development clone each keep theirs instead of rebuilding in turn. A build
    # is a folder named by a key, the 16 hex characters `cut -c1-16` keeps; xcrew's other folders prune their own.
    hex='[0-9a-f]'
    keyform="$hex$hex$hex$hex$hex$hex$hex$hex$hex$hex$hex$hex$hex$hex$hex$hex"
    find "$cache" -mindepth 1 -maxdepth 1 -type d -name "$keyform" ! -name "$key" -mtime +14 -exec rm -rf {} + 2>/dev/null || true
    # So do the stamps of checkouts no build has hashed for two weeks, as each plugin version's path is
    # a new checkout; one still in use is hashed again on its next run.
    find "$cache/roots" -type f -name '*.key' -mtime +14 -delete 2>/dev/null || true
fi
# Marks this build as in use, for the cleanup above.
touch "$cache/$key"
# exec replaces this shell, so the trap wouldn't run: the lock goes first.
if [ -n "${lock:-}" ]; then
    rm -rf "$lock"
    trap - EXIT
fi

# The mod runs the build directly, and asks here which one to run.
if [ "${1:-}" = --binary-path ]; then
    printf '%s\n' "$binary"
    exit 0
fi

if [ -n "${starting:-}" ]; then
    XCREW_ROOT=$root exec "$binary" "$@" <<INPUT
$input
INPUT
fi

XCREW_ROOT=$root exec "$binary" "$@"
