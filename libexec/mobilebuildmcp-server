#!/bin/sh
# Starts MobileBuildMCP in the project Claude Code names, since it reads its config from its working
# directory. Homebrew's prefixes are appended to PATH because Claude Code can start servers without them.
#
# A project that pins its Xcode in .xcode-version builds with it: the server gets that Xcode's developer
# folder as DEVELOPER_DIR, which every xcodebuild and simctl it runs inherits. The xcrew CLI is asked only
# when it's already built, for at most PIN_SECONDS; otherwise the server starts as it would without a pin.
# What happened is recorded for the doctor's xcode/pin check, which words it (docs/findings.md, *Which Xcode*).
PIN_SECONDS=2

plugin=$(cd -P "$(dirname "$0")/.." && pwd)
cd "$1" || exit
record="${XCREW_CACHE:-"$HOME/Library/Caches/xcrew"}/launches$(pwd -P).launch"
# A quick look, looser than the CLI's (Xcodes.pin): the root, then three levels down, past dependencies and hidden
# folders, whose pins are other projects'. A pin found here that the CLI doesn't count costs one short call.
if [ -f .xcode-version ] || [ -n "$(find . -maxdepth 3 -type d \( -name '.?*' -o -name node_modules -o -name Pods -o -name Carthage -o -name DerivedData -o -name build \) -prune -o -name .xcode-version -print -quit 2> /dev/null)" ]; then
    answer=$(mktemp)
    "$plugin/bin/xcrew" --if-built xcode --developer-dir < /dev/null > "$answer" 2> /dev/null &
    asked=$!
    (sleep "$PIN_SECONDS"; kill "$asked" 2> /dev/null) < /dev/null > /dev/null 2>&1 &
    timer=$!
    wait "$asked"
    status=$?
    # Reaped here, quietly: the shell would otherwise report the stopped timer on the server's standard error.
    { kill "$timer" && wait "$timer"; } 2> /dev/null
    developer=$(head -n 1 "$answer")
    rm -f "$answer"
    # The statuses are the CLI's (XcodeCommand), the shim's, and 143 for the CLI the timer stopped; the record holds
    # facts, which the doctor words.
    case $status in
        0) export DEVELOPER_DIR="$developer"; outcome="applied $developer" ;;
        3) outcome= ;;
        4) outcome="no match" ;;
        75) outcome="not built" ;;
        143) outcome="timed out $PIN_SECONDS" ;;
        *) outcome="failed $status" ;;
    esac
fi
if [ -n "${outcome:-}" ]; then
    mkdir -p "$(dirname "$record")" && printf '%s\n' "$outcome" > "$record"
else
    rm -f "$record"
fi
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin" exec mobilebuildmcp mcp
