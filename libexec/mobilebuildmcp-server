#!/bin/sh
# Starts MobileBuildMCP in the project Claude Code names, since it reads its config from its working
# directory. Homebrew's prefixes are appended to PATH because Claude Code can start servers without them.
#
# A project that pins its Xcode in .xcode-version builds with it: the server gets that Xcode's developer
# folder as DEVELOPER_DIR, which every xcodebuild and simctl it runs inherits. The xcrew CLI is asked only
# when it's already built, and its answer is waited for however long it takes: the server has the pin, or the
# record says why not. What happened is recorded for the doctor's xcode/pin check, which words it
# (docs/findings.md, *Which Xcode*).

plugin=$(cd -P "$(dirname "$0")/.." && pwd)
cd "$1" || exit
record="${XCREW_CACHE:-"$HOME/Library/Caches/xcrew"}/launches$(pwd -P).launch"
# A quick look with the CLI's own reach (Project.xcodePin): the root, then beside an Xcode container, which the CLI
# looks for as deep as MobileBuildMCP's own project discovery goes (ProjectLayout.searchDepth; ManifestTests pairs
# them), past dependencies and hidden folders, whose pins are other projects'. Only then is the CLI asked, so a
# project that pins nothing records nothing, built or not.
if [ -f .xcode-version ] || [ -n "$(find . -maxdepth 3 -type d \( -name '.?*' -o -name node_modules -o -name Pods -o -name Carthage -o -name DerivedData -o -name build \) -prune -o -name .xcode-version -print -quit 2> /dev/null)" ]; then
    answer=$("$plugin/bin/xcrew" --if-built xcode --developer-dir < /dev/null 2> /dev/null)
    status=$?
    developer=$(printf '%s\n' "$answer" | head -n 1)
    # The statuses are the CLI's (XcodeCommand) and the shim's; the record holds facts, which the doctor words.
    case $status in
        0) export DEVELOPER_DIR="$developer"; outcome="applied $developer" ;;
        3) outcome= ;;
        4) outcome="no match" ;;
        75) outcome="not built" ;;
        *) outcome="failed $status" ;;
    esac
fi
if [ -n "${outcome:-}" ]; then
    mkdir -p "$(dirname "$record")" && printf '%s\n' "$outcome" > "$record"
else
    rm -f "$record"
fi
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin" exec mobilebuildmcp mcp
